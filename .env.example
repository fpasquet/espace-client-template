# Copié en .env par make install. Valeurs de développement local seulement.

# Postgres de Docker Compose (port 5434, pour cohabiter avec facturation-api)
POSTGRES_PORT=5434
DATABASE_URL=postgresql://sandbox:sandbox@localhost:5434/sandbox

# API (apps/api) et interface (apps/web) ; l'interface appelle l'API directement (CORS limité à APP_URL)
PORT=4020
APP_URL=http://localhost:3020
API_URL=http://localhost:4020
